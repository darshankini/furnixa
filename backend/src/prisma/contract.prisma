// use prisma-8

enum UserRole {
  ADMIN
  MANAGER
  SALES
  CUTSHEET
  OPTIMISATION
  PURCHASE
  PRODUCTION
  DISPATCH
  ACCOUNTS
  USER
}

enum LeadStatus {
  ENQUIRY
  QUOTATION
  CUTSHEET
  OPTIMISATION
  PURCHASE
  PRODUCTION
  DISPATCH
  ACCOUNTS
  // Fully paid and closed; only admins and managers can move a lead here
  COMPLETED
}

/// Where a lead is inside the Production phase, in workshop order
enum ProductionStage {
  PRESSING_01_8FT
  PRESSING_02_10FT
  CUTTING_01
  CUTTING_02
  EDGE_BENDING_01
  EDGE_BENDING_02
  FINISHING
  CUT_OUT_MANUAL
  CARPENTER
  ROUTER_AND_HANDLE
  DRILLING
  CNC
  ASSEMBLY_QC
  PACKING
  DISPATCH_DEPARTMENT
  BILLING
}

enum PaymentMode {
  CASH
  UPI
  CARD
  CHEQUE
}

enum AssignmentRole {
  PRIMARY
  COLLABORATOR
}

/// Folder a lead document is stored in: each department uploads into its own folder
enum Department {
  SALES
  CUTSHEET
  OPTIMISATION
  PURCHASE
  PRODUCTION
  ACCOUNTS
  DISPATCH
}

model User {
  id           Int      @id @default(autoincrement())
  firstName    String
  lastName     String
  email        String   @unique
  passwordHash String
  mobile       String?
  role         UserRole @default(USER)
  isActive     Boolean  @default(true)

  createdLeads    Lead[] @relation("LeadCreatedBy")
  assignedLeads   Lead[] @relation("LeadAssignedBy")
  updatedLeads    Lead[] @relation("LeadUpdatedBy")
  chatClosedLeads Lead[] @relation("LeadChatClosedBy")
  productionStageLeads Lead[] @relation("LeadProductionStageBy")

  assignments     LeadUser[] @relation("LeadUserAssignee")
  assignmentsMade LeadUser[] @relation("LeadUserAssignedBy")
  documents       Document[]
  messages        ChatMessage[]
  payments        Payment[]

  statusChanges     LeadStatusHistory[] @relation("HistoryChangedBy")
  historyAssignedBy LeadStatusHistory[] @relation("HistoryAssignedBy")
  historyAssignedTo LeadStatusHistory[] @relation("HistoryAssignedTo")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@index([email])
  @@index([role])
}

model Client {
  id              Int     @id @default(autoincrement())
  firstName       String
  lastName        String
  mobile          String
  email           String?
  alternateMobile String?
  address         String? 
  passwordHash        String?

  leads    Lead[]
  messages ChatMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@index([mobile])
  @@index([email])
}

model Lead {
  id          Int        @id @default(autoincrement())
  clientId    Int
  projectName String
  status      LeadStatus @default(ENQUIRY)
  // Free text: what the client wants, e.g. "32 x 34 – 20 tables, 21 x 20 – 10 chairs"
  requirement String?
  // Entered when the lead moves into Quotation; payments are later tracked against it
  quotationAmount Numeric(12, 2)?

  client Client @relation(fields: [clientId], references: [id])

  assignedById Int?
  assignedBy   User? @relation(
    "LeadAssignedBy",
    fields: [assignedById],
    references: [id]
  )

  createdById Int?
  createdBy   User? @relation(
    "LeadCreatedBy",
    fields: [createdById],
    references: [id]
  )

  lastUpdatedById Int?
  lastUpdatedBy   User? @relation(
    "LeadUpdatedBy",
    fields: [lastUpdatedById],
    references: [id]
  )

  // Only an admin can close (or reopen) the lead chat; closed chats stay readable
  chatClosed     Boolean   @default(false)
  chatClosedAt   DateTime?
  chatClosedById Int?
  chatClosedBy   User? @relation(
    "LeadChatClosedBy",
    fields: [chatClosedById],
    references: [id]
  )

  // Current workshop stage; only set while the lead is (or was) in the Production phase
  productionStage            ProductionStage?
  productionStageUpdatedAt   DateTime?
  productionStageUpdatedById Int?
  productionStageUpdatedBy   User? @relation(
    "LeadProductionStageBy",
    fields: [productionStageUpdatedById],
    references: [id]
  )

  assignments   LeadUser[]
  documents     Document[]
  messages      ChatMessage[]
  statusHistory LeadStatusHistory[]
  payments      Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@index([clientId])
  @@index([status])
  @@index([assignedById])
  @@index([lastUpdatedById])
  @@index([createdAt])
}

model LeadUser {
  id     Int            @id @default(autoincrement())
  leadId Int
  userId Int
  role   AssignmentRole @default(COLLABORATOR)

  lead Lead @relation(
    fields: [leadId],
    references: [id],
    onDelete: Cascade
  )

  user User @relation(
    "LeadUserAssignee",
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  assignedById Int?
  assignedBy   User? @relation(
    "LeadUserAssignedBy",
    fields: [assignedById],
    references: [id]
  )

  assignedAt   DateTime  @default(now())
  // null = currently assigned; set when the user is taken off the lead (they keep chat access)
  unassignedAt DateTime?

  @@unique([leadId, userId])
  @@index([leadId])
  @@index([userId])
}

model LeadStatusHistory {
  id         Int        @id @default(autoincrement())
  leadId     Int
  fromStatus LeadStatus?
  toStatus   LeadStatus
  changedById Int

  lead Lead @relation(
    fields: [leadId],
    references: [id],
    onDelete: Cascade
  )

  changedBy User @relation(
    "HistoryChangedBy",
    fields: [changedById],
    references: [id]
  )

  // Set when this entry assigns the lead to someone (one entry per assignee, e.g. several designers)
  assignedById Int?
  assignedBy   User? @relation(
    "HistoryAssignedBy",
    fields: [assignedById],
    references: [id]
  )

  assignedToId Int?
  assignedTo   User? @relation(
    "HistoryAssignedTo",
    fields: [assignedToId],
    references: [id]
  )

  note String?

  changedAt DateTime @default(now())

  @@index([leadId])
  @@index([changedById])
  @@index([assignedById])
  @@index([assignedToId])
  @@index([changedAt])
}

model Document {
  id           Int        @id @default(autoincrement())
  leadId       Int
  status       LeadStatus
  department   Department

  originalName String
  fileName     String
  filePath     String
  extension    String?
  mimeType     String?
  fileSize     BigInt?

  uploadedById Int

  lead Lead @relation(
    fields: [leadId],
    references: [id],
    onDelete: Cascade
  )

  uploadedBy User @relation(
    fields: [uploadedById],
    references: [id]
  )

  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([status])
  @@index([department])
  @@index([uploadedById])
}

model ChatMessage {
  id     Int    @id @default(autoincrement())
  leadId Int
  // Exactly one sender: a staff user or the lead's client
  // 1 = staff user (userId is set), 2 = client (clientId is set)
  userType Int
  userId   Int?
  clientId Int?
  message String

  lead Lead @relation(
    fields: [leadId],
    references: [id],
    onDelete: Cascade
  )

  user User? @relation(
    fields: [userId],
    references: [id]
  )

  client Client? @relation(
    fields: [clientId],
    references: [id]
  )

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@index([leadId])
  @@index([userId])
  @@index([clientId])
  @@index([createdAt])
}

/// A payment received against a lead's quotation amount (Payment follow-up)
model Payment {
  id          Int            @id @default(autoincrement())
  leadId      Int
  amount      Numeric(12, 2)
  mode        PaymentMode
  // The day the money was received (midnight UTC of that date)
  paidOn      DateTime
  note        String?
  createdById Int

  lead Lead @relation(
    fields: [leadId],
    references: [id],
    onDelete: Cascade
  )

  createdBy User @relation(
    fields: [createdById],
    references: [id]
  )

  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([paidOn])
}
